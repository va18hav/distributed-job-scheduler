generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  priority    Int       @default(0)
  lockedBy    String?
  lockedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?
  availableAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt, priority(sort: Desc), createdAt(sort: Asc)], map: "idx_job_polling")
  @@index([status, lockedAt], map: "idx_job_stale_locks")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
